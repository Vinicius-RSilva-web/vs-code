import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  // This widget is the root of your application.
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'clinica odontologica',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(primaryColor: Colors.teal),
      home: const HomePage(),
    );
  }
}

class HomePage extends StatefulWidget {
  const HomePage({super.key});

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  String titulo = "Início";

  void alterarPagina(String novoTitulo) {
    setState(() {
      titulo = novoTitulo;
    });
    Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFEF7F4),
      appBar: AppBar(title: Text(titulo)),
      drawer: Drawer(
        child: ListView(
          children: [
            const DrawerHeader(
              decoration: BoxDecoration(color: Colors.teal),
              child: Text(
                "Clinica Soriso",
                style: TextStyle(color: Colors.white, fontSize: 20),
              ),
            ),
            ListTile(
              leading: const Icon(Icons.home),
              title: const Text("Inicio"),
              onTap: () => alterarPagina("Inicio"),
            ),
            ListTile(
              leading: const Icon(Icons.medical_services),
              title: const Text("Serviços"),
              onTap: () => alterarPagina("Serviços"),
            ),
            ListTile(
              leading: const Icon(Icons.calendar_today),
              title: const Text("Agendamento"),
              onTap: () => alterarPagina("Agendamento"),
            ),
            ListTile(
              leading: const Icon(Icons.phone),
              title: const Text("Contato"),
              onTap: () => alterarPagina("Contato"),
            ),
          ],
        ),
      ),
      body: Center(
        child: Text(
          "Bem Vindo á Clinica Odontológica",
          style: TextStyle(fontSize: 10, color: Colors.teal[900]),
        ),
      ),
      bottomNavigationBar: Container(
        height: 50,
        color: Colors.teal,
        child: const Center(
          child: Text(
            "2026 Clinica -Sorriso- Todos os direitos reservados",
            style: TextStyle(color: Colors.white),
          ),
        ),
      ),
    );
  }
}
